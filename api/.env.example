DATABASE_URL=postgresql://simaud:example@127.0.0.1:55432/simaud_dev
DATABASE_URL_TEST=postgresql://simaud:example@127.0.0.1:55432/simaud_test
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_URL=http://localhost:5173
HOST=127.0.0.1
PORT=3000
SEED_PASSWORD=ChangeMe123!
# NODE_ENV=development
MAIL_DRIVER=log
# RESEND_API_KEY=your-resend-key
# MAIL_REPLY_TO=soporte@example.com
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=SIMAUD <no-reply@example.com>

# false (default), true, número de saltos, o IPs/CIDRs separadas por comas
TRUST_PROXY=false

# T03: scheduler (siempre desactivado durante tests)
JOBS_ENABLED=false
EXPIRY_WARNING_DAYS=30

# DATABASE_URL_TEST solo se requiere en test; admite simaud_test y simaud_test2,
# siempre con nombre distinto de DATABASE_URL. dotenv conserva variables ya exportadas.
