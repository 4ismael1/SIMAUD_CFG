FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html vite.config.ts tsconfig*.json ./
COPY src ./src
COPY public ./public
# El contexto excluye .env.local para no empaquetar el modo demo ni secretos.
ENV VITE_UI_MOCK=0
RUN npm run build

FROM nginx:alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/security-headers.conf /etc/nginx/security-headers.conf
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
# Restringe envsubst para conservar variables de nginx como $uri y $host.
ENV NGINX_ENVSUBST_FILTER=^SERVER_NAME$
EXPOSE 80 443
