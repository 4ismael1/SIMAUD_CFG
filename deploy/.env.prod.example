# Copiar a .env.prod EN LA RAÍZ. Nunca versionar el archivo completado.
# openssl rand -base64 48 para JWT; openssl rand -hex 32 para PostgreSQL.
# No usar valores distintos entre POSTGRES_PASSWORD y DATABASE_URL.
SIMAUD_VERSION=2026.11.09-1
SERVER_NAME=simaud.universidad.example
APP_URL=https://simaud.universidad.example
POSTGRES_DB=simaud
POSTGRES_USER=simaud
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql://simaud:REPLACE_WITH_RANDOM_HEX@db:5432/simaud
# Obligatoria por el validador; esta BD NO se crea ni se usa en producción.
DATABASE_URL_TEST=postgresql://unused:unused@127.0.0.1:1/simaud_test
JWT_ACCESS_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48
SMTP_URL=smtps://REPLACE_USER:REPLACE_PASSWORD@smtp.universidad.example:465
MAIL_FROM="SIMAUD <no-reply@universidad.example>"
EXPIRY_WARNING_DAYS=30
# Compose fuerza estos valores para la API; migrate desactiva jobs y proxy.
NODE_ENV=production
PORT=3000
TRUST_PROXY=1
JOBS_ENABLED=true
# Rutas relativas a docker-compose.prod.yml; preparar permisos antes de arrancar.
TLS_CERTS_DIR=./deploy/certs
BACKUP_DIR=./deploy/backups
# No definir SEED_PASSWORD: el seed crea cuentas y contratos de demostración.
