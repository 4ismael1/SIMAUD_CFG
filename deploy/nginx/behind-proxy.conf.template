# Web container BEHIND the host's nginx (which owns the domain, TLS and Let's Encrypt renewal).
# Plain HTTP on the container; only reachable through 127.0.0.1 (see deploy/behind-proxy.compose.yml).
server {
    listen 80 default_server;
    server_name ${SERVER_NAME};

    # The host nginx is the only client: trust its X-Real-IP so $remote_addr is the visitor's IP and
    # the API (TRUST_PROXY=1) records the real address. Docker's bridge gateway is in these ranges.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Real-IP;

    root /usr/share/nginx/html;
    index index.html;
    # Uploads: the API enforces its own limits (PDF to verify up to 15 MiB).
    client_max_body_size 16m;
    include /etc/nginx/security-headers.conf;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # One trusted hop: never forward values sent by the client.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Content-Security-Policy;

    location = /api/v1/events {
        proxy_pass $api_upstream$request_uri;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        gzip off;
        error_log /dev/null crit;
    }

    location /api/ {
        proxy_pass $api_upstream$request_uri;
        proxy_read_timeout 120s;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/security-headers.conf;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }
}
